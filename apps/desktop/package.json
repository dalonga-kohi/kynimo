{
  "name": "@kynimo/desktop",
  "version": "0.1.0",
  "productName": "Kynimo",
  "private": true,
  "description": "Kynimo for Windows: an Electron app that runs the local MCP server and shows what agents make.",
  "author": "Kynimo",
  "type": "module",
  "main": "./out/main/index.mjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build && vite build --config vite.bridge.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icon": "node scripts/make-icon.mjs",
    "installer-art": "node scripts/make-installer-art.mjs",
    "package": "node scripts/package.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@kynimo/mcp": "workspace:*"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@kynimo/scene": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "files": [
    "out"
  ]
}
