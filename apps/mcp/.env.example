# Set these in your shell or in the MCP client's server config ("env"); kynimo-mcp does not read .env files.

# Keep projects in Postgres instead of memory or --dir. Holds a password: keep it out of logs.
KYNIMO_DATABASE_URL=postgresql://user:password@localhost:5432/kynimo

# Opt-in: run the real-server store tests against an empty, disposable database. They drop and
# recreate Kynimo's tables in it.
KYNIMO_TEST_DATABASE_URL=postgresql://user:password@localhost:5432/kynimo_test
