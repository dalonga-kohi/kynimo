{
  "name": "@kynimo/renderer",
  "version": "0.0.0",
  "private": true,
  "description": "Kynimo renderer: rasterizes evaluated frames with CanvasKit (Skia) for the WebGL2 compositor.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kynimo/engine": "workspace:*",
    "@kynimo/scene": "workspace:*",
    "canvaskit-wasm": "0.42.0"
  }
}
